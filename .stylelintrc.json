{
    "extends": "stylelint-config-standard",
    "rules": {
        "indentation": 4,
        "at-rule-no-unknown": [
            true,
            { "ignoreAtRules": ["tailwind", "apply"] }
        ],
        "hue-degree-notation": "number",
        "max-line-length": [120, { "ignorePattern": "/@apply\\s+.+;/" }]
    }
}
