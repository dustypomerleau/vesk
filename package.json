{
    "name": "vesk",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "imports": {
        "#lib": "./src/lib",
        "#lib/*": "./src/lib/*"
    },
    "scripts": {
        "build": "vite build",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
        "dev": "vite dev",
        "format": "oxfmt",
        "lint": "oxlint .",
        "preview": "vite preview",
        "test": "pnpm run test:unit -- --run && pnpm run test:e2e",
        "test:e2e": "playwright test",
        "test:unit": "vitest"
    },
    "devDependencies": {
        "@mdsvex/typescript-plugin": "0.1.0-next.6",
        "@netlify/plugin-lighthouse": "^6.0.4",
        "@playwright/test": "^1.65.1",
        "@prettier/plugin-oxc": "^0.2.4",
        "@sveltejs/adapter-netlify": "^7.0.1",
        "@sveltejs/kit": "^3.3.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/svelte": "^5.4.2",
        "globals": "^17.14.0",
        "jsdom": "^31.0.1",
        "mdsvex": "^1.0.1",
        "oxfmt": "^0.79.0",
        "oxlint": "^1.94.0",
        "prettier": "^3.10.1",
        "prettier-plugin-svelte": "^4.2.0",
        "rehype-class-names": "^2.0.0",
        "stylelint": "^18.0.0",
        "stylelint-config-standard": "^41.0.0",
        "stylelint-order": "^8.1.3",
        "svelte": "^5.58.0",
        "svelte-check": "^4.7.8",
        "typescript": "^6.0.3",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
    }
}
