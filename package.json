{
    "name": "vesk",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "dev": "vite dev",
        "format": "oxfmt",
        "lint": "oxlint .",
        "prepare": "svelte-kit sync || echo ''",
        "preview": "vite preview",
        "test": "pnpm run test:unit -- --run && pnpm run test:e2e",
        "test:e2e": "playwright test",
        "test:unit": "vitest"
    },
    "devDependencies": {
        "@netlify/plugin-lighthouse": "^6.0.4",
        "@playwright/test": "^1.64.1",
        "@prettier/plugin-oxc": "^0.2.3",
        "@sveltejs/adapter-netlify": "^6.0.4",
        "@sveltejs/kit": "^3.1.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/svelte": "^5.4.2",
        "globals": "^17.13.0",
        "jsdom": "^30.1.3",
        "mdsvex": "^0.12.8",
        "oxfmt": "^0.67.0",
        "oxlint": "^1.88.0",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "rehype-class-names": "^2.0.0",
        "stylelint": "^17.16.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-order": "^8.1.2",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.6",
        "typescript": "^6.0.3",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    }
}
